# Public settings for the storefront. All are exposed to the browser (NEXT_PUBLIC_ prefix),
# so never put secrets here. Copy to .env.local for local development; set the same names
# in Vercel → Settings → Environment Variables for production.

# ── Required ────────────────────────────────────────────────────────────────

# The Shreeni backend API base URL (no trailing slash).
# Local: http://localhost:8080 · Production: https://shreeni-backend.vercel.app
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# This site's own public URL (no trailing slash). Used for canonical links, sitemap.xml,
# robots.txt and share links. Production: https://shreeni-collection.in
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Optional ────────────────────────────────────────────────────────────────

# Google Tag Manager container. Defaults to GTM-TBLCPRBT; set to an empty value to turn
# tracking off. Only loaded in production builds.
# NEXT_PUBLIC_GTM_ID=GTM-TBLCPRBT

# Google Search Console "HTML tag" verification token (just the content="…" value).
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
